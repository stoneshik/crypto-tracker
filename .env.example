NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/crypto.db
SQLITE_BUSY_TIMEOUT_MS=5000
API_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
BODY_LIMIT_BYTES=16384
SHUTDOWN_TIMEOUT_MS=15000

# npm run setup creates JWT_SECRET and SERVICE_API_KEY in .env.
JWT_SECRET=
JWT_ISSUER=crypto-tracker
JWT_AUDIENCE=crypto-tracker-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
SERVICE_API_KEY=
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# CoinMarketCap key
CMC_API_KEY=
CMC_TIMEOUT_MS=10000
CMC_MAX_RETRIES=2
CMC_RETRY_DELAY_MS=500
CMC_RATE_LIMIT_COOLDOWN_SECONDS=60

SYNC_ENABLED=true
POLL_INTERVAL_SECONDS=300
SYNC_TICK_MS=5000
SYNC_ERROR_BACKOFF_SECONDS=60
# Seeds for the first start only. Manage the list through the API afterwards.
TRACKED_CURRENCIES='[{"cmcId":1,"symbol":"BTC","name":"Bitcoin"},{"cmcId":1027,"symbol":"ETH","name":"Ethereum"},{"cmcId":5426,"symbol":"SOL","name":"Solana"}]'

# Initial global retention: 1..3650 days or forever. Then stored in the database.
DEFAULT_RETENTION_DAYS=30
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_BATCH_SIZE=1000

# Only read by npm run admin:create. Remove after provisioning the account.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin_admin_admin
